# Server-side only. Do not rename these to NEXT_PUBLIC_*.
VERITYX_BACKEND_URL=http://127.0.0.1:8000
# Required only when the backend's service API-key protection is enabled.
VERITYX_API_KEY=replace-with-your-local-development-key

