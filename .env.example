# Copy this file to .env and replace every placeholder before deployment.
# Keep this file committed; never commit the real .env file.

# Use a URL-safe password (letters, numbers, underscore, hyphen only) because
# Compose embeds it in DATABASE_URL. Generate one with Python:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Generate a separate secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VERITYX_API_KEY=replace-with-a-long-random-service-key

# Set this to a real domain whose DNS A/AAAA record points to your server.
# Caddy obtains and renews TLS certificates automatically for public domains.
VERITYX_DOMAIN=your-domain.example

MAX_UPLOAD_SIZE_BYTES=52428800

# Optional SerpApi Google Lens provider. Evidence images are uploaded to SerpApi
# (compressed to <=500 KB); keep this key private and out of source control.
# Without a key, VerityX uses Openverse + Wikimedia Commons fallback.
# SERPAPI_API_KEY=your-serpapi-key
# VERITYX_CAPTION_MODEL=Salesforce/blip-image-captioning-base
# VERITYX_CLIP_MODEL=openai/clip-vit-base-patch32

# AI-image detector: Smaug-AI-Image-Detector runs locally in the worker.
# Optional decision threshold; default is 0.5 as suggested by the model card.
# VERITYX_AI_DETECTION_THRESHOLD=0.5

# Production browser origins (comma-separated); set to your exact Vercel domain(s).
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
